# syntax=docker/dockerfile:1.7

FROM node:24-alpine

ARG HOST_UID=1000
ARG HOST_GID=1000

WORKDIR /app

RUN apk add --no-cache su-exec \
    && corepack enable pnpm
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id=czar-web-react-dev-pnpm-store,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store \
    && pnpm install --frozen-lockfile \
    && install -d -o "${HOST_UID}" -g "${HOST_GID}" /home/czar \
    && chown -R "${HOST_UID}:${HOST_GID}" /app

COPY scripts/dev-entrypoint.sh /usr/local/bin/czar-web-react-dev-entrypoint
RUN chmod +x /usr/local/bin/czar-web-react-dev-entrypoint

ENV HOME=/home/czar
ENV XDG_CACHE_HOME=/home/czar/.cache
ENV CZAR_UID=${HOST_UID}
ENV CZAR_GID=${HOST_GID}

ENTRYPOINT ["/usr/local/bin/czar-web-react-dev-entrypoint"]

CMD ["pnpm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5175"]
