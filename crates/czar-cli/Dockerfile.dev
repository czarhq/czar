# syntax=docker/dockerfile:1.7

FROM lukemathwalker/cargo-chef:latest-rust-1.95.0

ARG HOST_UID=1000
ARG HOST_GID=1000

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:0.9.24 /uv /uvx /bin/

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv python-is-python3 gosu \
    && cargo install --locked cargo-watch@8.5.3 wasmtime-cli@48.0.5 \
    && install -d -o "${HOST_UID}" -g "${HOST_GID}" /cargo /cargo/registry /cargo/git /app/target /home/czar \
    && rm -rf /var/lib/apt/lists/*

COPY crates/czar-cli/scripts/dev-entrypoint.sh /usr/local/bin/czar-dev-entrypoint
RUN chmod +x /usr/local/bin/czar-dev-entrypoint

ENV CARGO_HOME=/cargo
ENV HOME=/home/czar
ENV XDG_CACHE_HOME=/home/czar/.cache
ENV CZAR_UID=${HOST_UID}
ENV CZAR_GID=${HOST_GID}

ENTRYPOINT ["/usr/local/bin/czar-dev-entrypoint"]

CMD ["cargo", "watch", "--poll", "--watch", "Cargo.toml", "--watch", "Cargo.lock", "--watch", "crates", "--watch", "examples/workflows", "--ignore", "target/", "--ignore", "examples/workflows/**/target/", "--ignore", "examples/workflows/**/logs/", "--ignore", "examples/workflows/**/*.duckdb", "--ignore", "examples/workflows/**/*.duckdb.wal", "--ignore", "examples/workflows/**/__pycache__/", "--ignore", "examples/workflows/**/.venv/", "-x", "run -p czar-cli --bin czar -- serve --addr 0.0.0.0:4000"]
